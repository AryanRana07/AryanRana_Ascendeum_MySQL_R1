<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink_light"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- NAME ENTRY -->
        <LinearLayout
            android:id="@+id/nameGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💌"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Missing You"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="What should your partner call you?"
                android:textColor="@color/text_soft" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:hint="Your name"
                android:padding="14dp"
                android:maxLength="24"
                android:inputType="textPersonName" />

            <Button
                android:id="@+id/nameContinueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:textColor="@color/white"
                android:text="Continue" />
        </LinearLayout>

        <!-- PAIRING -->
        <LinearLayout
            android:id="@+id/pairingGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💞"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="Link with your partner"
                android:textColor="@color/text_main"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/pairingChooseGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/generateCodeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/white"
                    android:text="Generate a pairing code" />

                <Button
                    android:id="@+id/haveCodeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/pink_deep"
                    android:text="I have a code" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pairingCreateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Send this code to your partner:"
                    android:textColor="@color/text_soft" />

                <TextView
                    android:id="@+id/pairingCodeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_code_box"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:padding="18dp"
                    android:text="..."
                    android:textColor="@color/pink_deep"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/pairingCreateBackButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/pink_deep"
                    android:text="Back" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pairingJoinGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Enter your partner's code:"
                    android:textColor="@color/text_soft" />

                <EditText
                    android:id="@+id/codeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_code_box"
                    android:gravity="center"
                    android:hint="ABC123"
                    android:maxLength="8"
                    android:inputType="textCapCharacters"
                    android:padding="14dp" />

                <TextView
                    android:id="@+id/pairingErrorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/pink_deep"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/linkUpButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/white"
                    android:text="Link up" />

                <Button
                    android:id="@+id/pairingJoinBackButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/pink_deep"
                    android:text="Back" />
            </LinearLayout>
        </LinearLayout>

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/homeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/partnerStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:textColor="@color/text_soft" />

            <TextView
                android:id="@+id/statusBannerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="@color/pink_deep"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/missYouButton"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_miss_you_button"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="💗\nI miss you" />

            <TextView
                android:id="@+id/homeHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/text_soft"
                android:visibility="gone" />

            <TextView
                android:id="@+id/unlinkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:padding="8dp"
                android:text="Unlink from partner"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />
        </LinearLayout>

    </FrameLayout>
</ScrollView>
