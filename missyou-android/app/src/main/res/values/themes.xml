<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Plain AppCompat, not MaterialComponents: MaterialComponents auto-inflates <Button>
        as MaterialButton, which force-tints every button's background to colorPrimary and
        ignores our custom android:background drawables. That made the "secondary" style
        buttons render as solid colorPrimary with same-color (invisible) text.
    -->
    <style name="Theme.MissYou" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pink_deep</item>
        <item name="colorPrimaryDark">@color/pink_deep</item>
        <item name="colorAccent">@color/purple</item>
        <item name="android:windowBackground">@color/pink_light</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pink_deep</item>
    </style>

    <style name="Theme.MissYou.Transparent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
