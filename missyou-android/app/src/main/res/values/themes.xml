<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MissYou" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pink_deep</item>
        <item name="colorPrimaryDark">@color/pink_deep</item>
        <item name="colorAccent">@color/purple</item>
        <item name="android:windowBackground">@color/pink_light</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pink_deep</item>
    </style>

    <style name="Theme.MissYou.Transparent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
